{
  "name": "AI Invoice & Receipt Extractor (Email PDF → Structured Data → Google Sheets)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyX", "value": 5, "unit": "minutes" }] },
        "simple": false,
        "filters": { "q": "has:attachment filename:pdf (invoice OR receipt OR bill) is:unread" },
        "options": { "downloadAttachments": true }
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000001",
      "name": "Invoice Email Arrives",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "credentials": { "gmailOAuth2": { "id": "REPLACE_ME", "name": "Gmail account" } }
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "attachment_0",
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000002",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'gpt-4o-mini',\n  temperature: 0,\n  response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: 'Extract invoice data. Reply ONLY with JSON: {\"vendor\": string, \"invoice_number\": string, \"invoice_date\": \"YYYY-MM-DD\" or \"\", \"due_date\": \"YYYY-MM-DD\" or \"\", \"currency\": ISO code, \"subtotal\": number, \"tax\": number, \"total\": number, \"line_items\": [{\"description\": string, \"quantity\": number, \"unit_price\": number, \"amount\": number}]}. Use null for anything not present. Do NOT guess numbers.' },\n    { role: 'user', content: String($json.text || '').slice(0, 12000) }\n  ]\n}) }}",
        "options": { "timeout": 60000 }
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000003",
      "name": "AI Extract Fields",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "credentials": { "openAiApi": { "id": "REPLACE_ME", "name": "OpenAI account" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Parse + sanity-check the numbers. Flag anything that doesn't add up for human review.\nconst src = $('Invoice Email Arrives').first().json;\nlet d;\ntry { d = JSON.parse($json.choices[0].message.content); } catch (e) { d = {}; }\nconst num = v => (v === null || v === undefined || v === '' ? null : Number(v));\nconst subtotal = num(d.subtotal), tax = num(d.tax), total = num(d.total);\nconst items = Array.isArray(d.line_items) ? d.line_items : [];\nconst itemsSum = items.reduce((s, li) => s + (Number(li.amount) || 0), 0);\nconst issues = [];\nif (total === null) issues.push('missing total');\nif (subtotal !== null && tax !== null && total !== null && Math.abs(subtotal + tax - total) > 0.02) issues.push('subtotal + tax != total');\nif (items.length && subtotal !== null && Math.abs(itemsSum - subtotal) > 0.02) issues.push('line items != subtotal');\nreturn [{ json: {\n  vendor: d.vendor || '', invoice_number: d.invoice_number || '', invoice_date: d.invoice_date || '', due_date: d.due_date || '',\n  currency: d.currency || '', subtotal, tax, total, line_item_count: items.length,\n  needs_review: issues.length > 0, issues: issues.join('; '),\n  email_subject: src.subject || '', email_from: src.from?.value?.[0]?.address || '',\n}}];"
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000004",
      "name": "Validate Totals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "REPLACE_WITH_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Invoices", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Vendor": "={{ $json.vendor }}",
            "Invoice #": "={{ $json.invoice_number }}",
            "Invoice Date": "={{ $json.invoice_date }}",
            "Due Date": "={{ $json.due_date }}",
            "Currency": "={{ $json.currency }}",
            "Subtotal": "={{ $json.subtotal }}",
            "Tax": "={{ $json.tax }}",
            "Total": "={{ $json.total }}",
            "Needs Review": "={{ $json.needs_review ? 'YES' : '' }}",
            "Issues": "={{ $json.issues }}",
            "From": "={{ $json.email_from }}"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000005",
      "name": "Append to Invoices Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [880, 200],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            { "id": "r1", "leftValue": "={{ $json.needs_review }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ]
        },
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000006",
      "name": "Needs Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 420]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#finance", "mode": "name" },
        "text": "={{ ':warning: *Invoice needs review*\\n*Vendor:* ' + $json.vendor + '\\n*Invoice #:* ' + $json.invoice_number + '\\n*Total:* ' + $json.total + ' ' + $json.currency + '\\n*Issues:* ' + $json.issues }}",
        "otherOptions": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000007",
      "name": "Flag on Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1100, 400],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack account" } }
    }
  ],
  "connections": {
    "Invoice Email Arrives": { "main": [[{ "node": "Extract PDF Text", "type": "main", "index": 0 }]] },
    "Extract PDF Text": { "main": [[{ "node": "AI Extract Fields", "type": "main", "index": 0 }]] },
    "AI Extract Fields": { "main": [[{ "node": "Validate Totals", "type": "main", "index": 0 }]] },
    "Validate Totals": {
      "main": [[
        { "node": "Append to Invoices Sheet", "type": "main", "index": 0 },
        { "node": "Needs Review?", "type": "main", "index": 0 }
      ]]
    },
    "Needs Review?": { "main": [[{ "node": "Flag on Slack", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
