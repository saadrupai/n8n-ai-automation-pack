{
  "name": "AI Lead Qualifier (Website Form → AI Score → Sheets CRM + Slack)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000001",
      "name": "Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "b1b2c3d4-0002-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "jsCode": "// Validate input early: reject junk before spending AI tokens.\nconst b = $json.body || {};\nconst email = String(b.email || '').trim().toLowerCase();\nconst valid = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email);\nconst freeDomains = ['gmail.com','yahoo.com','hotmail.com','outlook.com','icloud.com','proton.me'];\nconst domain = email.split('@')[1] || '';\nreturn [{ json: {\n  valid,\n  name: String(b.name || '').trim().slice(0, 100),\n  email,\n  company: String(b.company || '').trim().slice(0, 120),\n  website: String(b.website || '').trim().slice(0, 200),\n  budget: String(b.budget || '').trim().slice(0, 50),\n  message: String(b.message || '').trim().slice(0, 2000),\n  businessEmail: valid && !freeDomains.includes(domain),\n  receivedAt: new Date().toISOString(),\n}}];"
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000002",
      "name": "Validate & Normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            { "id": "v1", "leftValue": "={{ $json.valid }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ]
        },
        "options": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000003",
      "name": "Valid Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'gpt-4o-mini',\n  temperature: 0,\n  response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: 'You are a B2B sales qualification assistant. Score the inbound lead from 0-100 using BANT (budget, authority, need, timeline). Reply ONLY with JSON: {\"score\": integer, \"tier\": \"hot\"|\"warm\"|\"cold\", \"need\": short phrase, \"reasoning\": one sentence, \"next_step\": one concrete sales action}. Business email domains and clear budgets raise the score. Vague or spammy messages are cold.' },\n    { role: 'user', content: JSON.stringify({ name: $json.name, email: $json.email, business_email: $json.businessEmail, company: $json.company, website: $json.website, budget: $json.budget, message: $json.message }) }\n  ]\n}) }}",
        "options": { "timeout": 30000 }
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000004",
      "name": "AI Score Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 200],
      "credentials": { "openAiApi": { "id": "REPLACE_ME", "name": "OpenAI account" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Validate & Normalise').first().json;\nlet ai;\ntry { ai = JSON.parse($json.choices[0].message.content); } catch (e) { ai = { score: 0, tier: 'cold', need: '', reasoning: 'AI parse failed - review manually', next_step: 'Review manually' }; }\nai.score = Math.max(0, Math.min(100, parseInt(ai.score, 10) || 0));\nif (!['hot','warm','cold'].includes(ai.tier)) ai.tier = ai.score >= 70 ? 'hot' : ai.score >= 40 ? 'warm' : 'cold';\nreturn [{ json: { ...lead, ...ai } }];"
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000005",
      "name": "Parse Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "REPLACE_WITH_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Leads", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Received": "={{ $json.receivedAt }}",
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Company": "={{ $json.company }}",
            "Budget": "={{ $json.budget }}",
            "Score": "={{ $json.score }}",
            "Tier": "={{ $json.tier }}",
            "Need": "={{ $json.need }}",
            "Next Step": "={{ $json.next_step }}"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000006",
      "name": "Save to CRM Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1100, 100],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            { "id": "h1", "leftValue": "={{ $json.tier }}", "rightValue": "hot", "operator": { "type": "string", "operation": "equals" } }
          ]
        },
        "options": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000007",
      "name": "Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#sales", "mode": "name" },
        "text": "={{ ':fire: *Hot lead (' + $json.score + '/100)*\\n*' + $json.name + '* · ' + $json.company + ' · ' + $json.email + '\\n*Need:* ' + $json.need + '\\n*Budget:* ' + ($json.budget || 'n/a') + '\\n*Why:* ' + $json.reasoning + '\\n*Next step:* ' + $json.next_step }}",
        "otherOptions": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000008",
      "name": "Ping Sales on Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1320, 260],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack account" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, message: 'Thanks! We will get back to you shortly.' }) }}",
        "options": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000009",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 460]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'Please provide a valid email address.' }) }}",
        "options": { "responseCode": 400 }
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000010",
      "name": "Respond Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 420]
    }
  ],
  "connections": {
    "Form Webhook": { "main": [[{ "node": "Validate & Normalise", "type": "main", "index": 0 }]] },
    "Validate & Normalise": { "main": [[{ "node": "Valid Email?", "type": "main", "index": 0 }]] },
    "Valid Email?": {
      "main": [
        [{ "node": "AI Score Lead", "type": "main", "index": 0 }],
        [{ "node": "Respond Invalid", "type": "main", "index": 0 }]
      ]
    },
    "AI Score Lead": { "main": [[{ "node": "Parse Score", "type": "main", "index": 0 }]] },
    "Parse Score": {
      "main": [[
        { "node": "Save to CRM Sheet", "type": "main", "index": 0 },
        { "node": "Hot Lead?", "type": "main", "index": 0 },
        { "node": "Respond OK", "type": "main", "index": 0 }
      ]]
    },
    "Hot Lead?": { "main": [[{ "node": "Ping Sales on Slack", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
